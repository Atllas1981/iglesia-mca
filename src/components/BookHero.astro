---
import { Image } from "astro:assets";
import liderazgoFrente from "../assets/libro/LiderazgoBiblicoFrente.webp";
import liderazgoTrasera from "../assets/libro/LiderazgoBiblicoTrasera.webp";
import genesisFrente from "../assets/libro/DescubriendoGenesisFrente.webp";
import genesisTrasera from "../assets/libro/DescubriendoGenesisTrasera.webp";

const libros = [
  {
    titulo: ["Liderazgo", "Bíblico"],
    descripcion: "Manual práctico para líderes, gerentes, miembros de grupos de trabajo, pastores, directores y mentores.",
    linkAmazon: "https://www.amazon.com/dp/B0DHQNWF7M",
    imagenFrente: liderazgoFrente,
    imagenTrasera: liderazgoTrasera,
    altFrente: "Portada Liderazgo Bíblico",
    altTrasera: "Contraportada Liderazgo Bíblico",
    traseraClases: "-left-1 -top-6 w-[72%] rotate-[10deg] sm:left-0 sm:-top-12",
    frenteClases: "w-[82%] translate-x-5 translate-y-4 rotate-0 sm:translate-x-12 sm:translate-y-8",
    offsetContenedor: "-left-11 w-[195px] sm:-left-28 sm:w-[378px]"
  },
  {
    titulo: ["Descubriendo", "Génesis"],
    descripcion: "Libro de estudio profundo del Génesis con más de 150 revelaciones que confirman hechos especiales y desconocidos de los manuscritos en hebreo y arameo, con profunda traducción e investigación de los rollos del mar muerto.",
    linkAmazon: "https://www.amazon.com/dp/B0DHQNWF7M",
    imagenFrente: genesisFrente,
    imagenTrasera: genesisTrasera,
    altFrente: "Portada Descubriendo Génesis",
    altTrasera: "Contraportada Descubriendo Génesis",
    traseraClases: "-left-3 -top-10 w-[72%] rotate-[7deg] sm:-left-5 sm:-top-24",
    frenteClases: "w-[74%] translate-x-4 translate-y-3 rotate-[-8deg] sm:translate-x-8 sm:translate-y-6",
    offsetContenedor: "-left-9 w-[195px] sm:-left-24 sm:w-[378px]"
  }
];
---

<section class="overflow-x-hidden bg-[#0B132B] px-4 py-16 text-slate-800 sm:px-8 sm:py-28">
  <div class="mx-auto max-w-6xl">
    
    <div class="mb-12 flex justify-center sm:mb-20">
      <div class="inline-flex items-center gap-2 rounded-full border border-slate-700 bg-slate-900/60 px-4 py-1.5 text-slate-200 shadow-sm backdrop-blur sm:gap-2.5 sm:px-5 sm:py-2">
        <svg class="h-3.5 w-3.5 fill-current text-white sm:h-4 sm:w-4" viewBox="0 0 24 24" aria-hidden="true">
          <polygon points="5 3 19 12 5 21 5 3"></polygon>
        </svg>
        <span class="text-xs font-semibold tracking-wide sm:text-sm">Profundiza en la Palabra</span>
      </div>
    </div>

    <div class="grid grid-cols-1 justify-items-center gap-12 sm:gap-24 lg:grid-cols-2 lg:gap-20">
      {libros.map((libro) => (
        <article class="relative flex aspect-[1/0.92] w-full max-w-[260px] flex-col justify-between rounded-3xl bg-[#E5E5E5] p-2 shadow-2xl sm:aspect-square sm:max-w-[400px] sm:rounded-[3rem] sm:p-7">
          
          <div class={`pointer-events-none absolute top-1/2 z-20 -translate-y-1/2 ${libro.offsetContenedor}`}>
            <div class="relative w-full">
              
              <div class={`absolute drop-shadow-xl ${libro.traseraClases}`}>
                <Image 
                  src={libro.imagenTrasera} 
                  alt={libro.altTrasera} 
                  class="h-auto w-full object-contain" 
                  width={480} 
                  format="webp"
                />
              </div>

              <div class={`relative z-10 drop-shadow-2xl ${libro.frenteClases}`}>
                <Image 
                  src={libro.imagenFrente} 
                  alt={libro.altFrente} 
                  class="h-auto w-full object-contain" 
                  width={480} 
                  format="webp"
                />
              </div>

            </div>
          </div>

          <div class="ml-auto flex h-full w-[54%] flex-col justify-center gap-2 text-left sm:w-[55%] sm:gap-5 sm:pl-2">
            <div class="space-y-1 sm:space-y-3">
              <h2 class="font-display text-base font-black leading-tight tracking-tight text-slate-900 sm:text-3xl">
                {libro.titulo[0]}<br />{libro.titulo[1]}
              </h2>
              <p class="text-[9.5px] font-medium leading-tight text-slate-600 sm:text-sm sm:leading-relaxed">
                {libro.descripcion}
              </p>
            </div>

            <div>
              <a 
                href={libro.linkAmazon} 
                target="_blank" 
                rel="noopener noreferrer" 
                aria-label={`Comprar ${libro.titulo.join(" ")} en Amazon`}
                class="inline-flex items-center rounded-lg bg-[#0F172A] px-3.5 py-1.5 text-white shadow-md transition-colors hover:bg-black sm:rounded-2xl sm:px-8 sm:py-3"
              >
                <span class="text-xs font-bold tracking-wide sm:text-base">amazon</span>
              </a>
            </div>
          </div>

        </article>
      ))}
    </div>

  </div>
</section>