---
import { Image } from "astro:assets";
import liderazgoFrente from "../assets/libro/LiderazgoBiblicoFrente.webp";
import liderazgoTrasera from "../assets/libro/LiderazgoBiblicoTrasera.webp";
import genesisFrente from "../assets/libro/DescubriendoGenesisFrente.webp";
import genesisTrasera from "../assets/libro/DescubriendoGenesisTrasera.webp";
---

<section class="bg-[#0B132B] px-6 py-28 text-slate-800">
  <div class="mx-auto max-w-6xl">
    
    <!-- Badge Superior -->
    <div class="mb-24 flex justify-center">
      <div class="inline-flex items-center gap-2.5 rounded-full border border-slate-700 bg-slate-900/60 px-5 py-2 text-slate-200 shadow-sm backdrop-blur">
        <svg class="h-4 w-4 fill-current text-white" viewBox="0 0 24 24">
          <polygon points="5 3 19 12 5 21 5 3"></polygon>
        </svg>
        <span class="text-sm font-semibold tracking-wide">Profundiza en la Palabra</span>
      </div>
    </div>

    <!-- Grid de Tarjetas -->
    <div class="grid grid-cols-1 justify-items-center gap-28 lg:grid-cols-2 lg:gap-24">

      <!-- ═══ TARJETA 1: LIDERAZGO BÍBLICO ═══ -->
      <div class="relative flex aspect-square w-full max-w-[430px] flex-col justify-between rounded-[3rem] bg-[#E5E5E5] p-8 sm:p-10 shadow-2xl">
        
        <!-- Contenedor de Libros -->
        <div class="pointer-events-none absolute -left-28 top-1/2 z-20 w-[350px] -translate-y-1/2 sm:-left-36 sm:w-[435px]">
          <div class="relative w-full">
            
            <!-- Contraportada (Trasera) -->
            <div class="absolute left-0 -top-12 w-[72%] rotate-[10deg] drop-shadow-xl">
              <Image 
                src={liderazgoTrasera} 
                alt="Liderazgo Bíblico Trasera" 
                class="h-auto w-full object-contain" 
                width={480} 
              />
            </div>

            <!-- Portada Principal (Frente) -->
            <div class="relative z-10 w-[82%] translate-x-12 translate-y-8 rotate-0 drop-shadow-2xl">
              <Image 
                src={liderazgoFrente} 
                alt="Liderazgo Bíblico Frente" 
                class="h-auto w-full object-contain" 
                width={480} 
              />
            </div>

          </div>
        </div>

        <!-- Contenido -->
        <div class="ml-auto flex h-full w-[55%] flex-col justify-between pl-2 text-left">
          <div class="space-y-4 pt-4">
            <!-- Título con Satoshi mediante font-display -->
            <h2 class="font-display text-2xl font-black leading-tight tracking-tight text-slate-900 sm:text-3xl">
              Liderazgo<br />Bíblico
            </h2>
            <p class="text-xs font-medium leading-relaxed text-slate-600 sm:text-sm">
              Manual práctico para líderes, gerentes, miembros de grupos de trabajo, pastores, directores y mentores.
            </p>
          </div>

          <div class="pb-2">
            <a 
              href="https://www.amazon.com/dp/B0DHQNWF7M" 
              target="_blank" 
              rel="noopener noreferrer" 
              class="inline-flex items-center rounded-2xl bg-[#0F172A] px-8 py-3 text-white shadow-md transition-colors hover:bg-black"
            >
              <span class="text-base font-bold tracking-wide">amazon</span>
            </a>
          </div>
        </div>

      </div>

      <!-- ═══ TARJETA 2: DESCUBRIENDO GÉNESIS ═══ -->
      <div class="relative flex aspect-square w-full max-w-[430px] flex-col justify-between rounded-[3rem] bg-[#E5E5E5] p-8 sm:p-10 shadow-2xl">
        
        <!-- Contenedor de Libros -->
        <div class="pointer-events-none absolute -left-24 top-1/2 z-20 w-[350px] -translate-y-1/2 sm:-left-32 sm:w-[435px]">
          <div class="relative w-full">
            
            <!-- Contraportada (Trasera) -->
            <div class="absolute -left-5 -top-24 w-[72%] rotate-[7deg] drop-shadow-xl">
              <Image 
                src={genesisTrasera} 
                alt="Descubriendo Génesis Trasera" 
                class="h-auto w-full object-contain" 
                width={480} 
              />
            </div>

            <!-- Portada Principal (Frente) -->
            <div class="relative z-10 w-[74%] translate-x-8 translate-y-6 rotate-[-8deg] drop-shadow-2xl">
              <Image 
                src={genesisFrente} 
                alt="Descubriendo Génesis Frente" 
                class="h-auto w-full object-contain" 
                width={480} 
              />
            </div>

          </div>
        </div>

        <!-- Contenido -->
        <div class="ml-auto flex h-full w-[55%] flex-col justify-between pl-2 text-left">
          <div class="space-y-3 pt-2">
            <!-- Título con Satoshi mediante font-display -->
            <h2 class="font-display text-2xl font-black leading-tight tracking-tight text-slate-900 sm:text-3xl">
              Descubriendo<br />Génesis
            </h2>
            <p class="text-[11px] font-medium leading-relaxed text-slate-600 sm:text-xs">
              Libro de estudio profundo del Génesis con más de 150 revelaciones que confirman hechos especiales y desconocidos de los manuscritos en hebreo y arameo, con profunda traducción e investigación de los rollos del mar muerto.
            </p>
          </div>

          <div class="pb-2">
            <a 
              href="https://www.amazon.com/dp/B0DHQNWF7M" 
              target="_blank" 
              rel="noopener noreferrer" 
              class="inline-flex items-center rounded-2xl bg-[#0F172A] px-8 py-3 text-white shadow-md transition-colors hover:bg-black"
            >
              <span class="text-base font-bold tracking-wide">amazon</span>
            </a>
          </div>
        </div>

      </div>

    </div>
  </div>
</section>