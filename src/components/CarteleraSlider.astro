---
// src/components/CarteleraSlider.astro

interface Slide {
  id: string;
  url: string;
  alt: string;
  order: number;
  active: boolean;
}

let slides: { imageUrl: string; title: string }[] = [];

try {
  const runtime = (Astro.locals as any)?.runtime;
  const KV = runtime?.env?.KV;

  if (KV) {
    const data = await KV.get('cartelera_slides');
    const raw: Slide[] = data ? JSON.parse(data) : [];
    slides = raw
      .filter((s) => s.active)
      .sort((a, b) => a.order - b.order)
      .map((s) => ({ imageUrl: s.url, title: s.alt }));
  }
} catch (e) {
  console.error('Error leyendo cartelera desde KV:', e);
}

const { title = "Cartelera" } = Astro.props;
---

<section class="w-full bg-white py-8 md:py-12">
  <div class="w-full relative">
    
    <!-- Encabezado con icono y botones de navegación -->
    <div class="flex items-center justify-between md:justify-start gap-4 mb-8 md:mb-10 px-4 sm:px-6 md:px-12 max-w-6xl mx-auto">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 md:w-11 md:h-11 rounded-full bg-[#F5ECCB] border border-[#E8DAAA] flex items-center justify-center text-[#C59E3F] shadow-sm flex-shrink-0">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 md:w-6 md:h-6 text-[#C59E3F]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M11 5.882V19.24a1.76 1.76 0 01-3.417.592l-2.147-6.15M18 13a3 3 0 100-6M11 5.882l5 3.118a1.76 1.76 0 010 3L11 15.118" />
          </svg>
        </div>
        <h2 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-slate-900 tracking-tight">
          {title}
        </h2>
      </div>

      <!-- Botones de navegación tipo píldora / círculo gris -->
      <div class="flex items-center gap-2 ml-2">
        <button class="btn-left w-9 h-9 md:w-10 md:h-10 rounded-full bg-slate-300/80 hover:bg-slate-400/80 flex items-center justify-center text-slate-800 transition-colors cursor-pointer shadow-sm" aria-label="Anterior">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
          </svg>
        </button>
        <button class="btn-right w-9 h-9 md:w-10 md:h-10 rounded-full bg-slate-300/80 hover:bg-slate-400/80 flex items-center justify-center text-slate-800 transition-colors cursor-pointer shadow-sm" aria-label="Siguiente">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
          </svg>
        </button>
      </div>
    </div>

    <!-- Contenedor del Slider / Posters -->
    <div class="cartelera-container w-full relative">
      <div class="cartelera-slider flex overflow-x-auto snap-x snap-mandatory gap-4 md:gap-6 scroll-pl-0 no-scrollbar py-2">
        {slides.length > 0 ? (
          slides.map((slide: any) => (
            <article 
              class="relative flex-none w-[75%] sm:w-[48%] md:w-[23%] aspect-[9/16] snap-start rounded-[2rem] md:rounded-[2.2rem] overflow-hidden shadow-lg hover:shadow-2xl border border-slate-100 group cursor-pointer bg-slate-100 slider-card transition-all duration-300" 
              data-image-url={slide.imageUrl} 
              aria-label={slide.title || "Ver anuncio"}
            >
              <figure class="w-full h-full overflow-hidden m-0">
                <img
                  src={slide.imageUrl}
                  alt={slide.title || "Imagen de anuncio"}
                  loading="lazy"
                  decoding="async"
                  class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-105 will-change-transform"
                />
              </figure>
            </article>
          ))
        ) : (
          [1, 2, 3, 4].map((item) => (
            <article 
              class="relative flex-none w-[75%] sm:w-[48%] md:w-[23%] aspect-[9/16] snap-start rounded-[2rem] md:rounded-[2.2rem] overflow-hidden shadow-lg border border-slate-100 bg-slate-100 flex items-center justify-center p-4 text-center text-slate-400"
            >
              <div class="flex flex-col items-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-10 h-10 opacity-30" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                </svg>
                <span class="text-xs font-semibold">Anuncio MCA #{item}</span>
              </div>
            </article>
          ))
        )}
      </div>
    </div>
  </div>
</section>

<dialog id="imageModal" class="backdrop:bg-black/90 bg-transparent p-0 m-auto max-w-5xl max-h-screen rounded-xl shadow-2xl backdrop:backdrop-blur-sm open:flex flex-col items-center justify-center border-none">
  <div class="relative flex flex-col items-center">
    <button id="closeModal" class="fixed top-4 right-4 md:top-6 md:right-6 z-50 bg-black/50 hover:bg-black/80 text-white rounded-full p-2 transition-colors cursor-pointer border border-white/20" aria-label="Cerrar modal">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 md:h-10 md:w-10" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
    <img id="modalImage" src="" alt="Imagen ampliada" class="max-w-full max-h-[85vh] object-contain rounded-lg" />
  </div>
</dialog>

<script>
  function initCarteleras() {
    const containers = document.querySelectorAll('.cartelera-container');
    containers.forEach((container) => {
      const slider = container.querySelector('.cartelera-slider');
      const parentCard = container.closest('section') || container.parentElement;
      const btnLeft = parentCard ? parentCard.querySelector('.btn-left') : null;
      const btnRight = parentCard ? parentCard.querySelector('.btn-right') : null;

      if (!slider) return;

      if (btnLeft) {
        const newBtnLeft = btnLeft.cloneNode(true);
        if (btnLeft.parentNode) btnLeft.parentNode.replaceChild(newBtnLeft, btnLeft);
        newBtnLeft.addEventListener('click', () => {
          const offset = slider.clientWidth * 0.8;
          slider.scrollBy({ left: -offset, behavior: 'smooth' });
        });
      }

      if (btnRight) {
        const newBtnRight = btnRight.cloneNode(true);
        if (btnRight.parentNode) btnRight.parentNode.replaceChild(newBtnRight, btnRight);
        newBtnRight.addEventListener('click', () => {
          const offset = slider.clientWidth * 0.8;
          slider.scrollBy({ left: offset, behavior: 'smooth' });
        });
      }

      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            slider.classList.add('animate-peek');
            observer.unobserve(entry.target);
          }
        });
      }, { threshold: 0.3 });
      observer.observe(container);
    });

    const modal = document.getElementById('imageModal') as HTMLDialogElement;
    const modalImg = document.getElementById('modalImage') as HTMLImageElement;
    const closeModalBtn = document.getElementById('closeModal');

    if (modal && modalImg && closeModalBtn) {
      const cards = document.querySelectorAll('.slider-card');
      cards.forEach(card => {
        card.addEventListener('click', () => {
          const imageUrl = card.getAttribute('data-image-url');
          if (imageUrl) {
            modalImg.src = imageUrl;
            modal.showModal();
            document.body.style.overflow = 'hidden';
          }
        });
      });

      closeModalBtn.addEventListener('click', () => {
        modal.close();
        document.body.style.overflow = '';
      });

      modal.addEventListener('click', (e) => {
        if (e.target === modal) {
          modal.close();
          document.body.style.overflow = '';
        }
      });
    }
  }

  initCarteleras();
  document.addEventListener('astro:page-load', initCarteleras);
</script>

<style>
  .no-scrollbar::-webkit-scrollbar { display: none; }
  .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }

  .animate-peek {
    animation: slider-peek 1.2s cubic-bezier(0.25, 1, 0.5, 1);
  }

  @keyframes slider-peek {
    0%, 100% { transform: translateX(0); }
    50% { transform: translateX(-50px); }
  }
</style>