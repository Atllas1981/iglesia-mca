---
// src/components/Location.astro
---

<section id="location" class="relative bg-white pt-8 pb-0">
    <!-- Tarjeta navy con bordes redondeados que se entrelaza con la Cartelera -->
    <div class="max-w-6xl mx-auto px-4 sm:px-6 pb-16">
        <div class="bg-[#0c2243] rounded-[2.5rem] md:rounded-[3rem] p-8 sm:p-10 md:p-14 shadow-2xl">
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center">

                <!-- Content Section -->
                <div class="text-white space-y-10">
                    <!-- Visítanos -->
                    <div>
                        <div class="flex items-center gap-3 mb-4">
                            <div class="w-9 h-9 rounded-full bg-[#F5ECCB] border border-[#E8DAAA] flex items-center justify-center flex-shrink-0">
                                <svg class="w-4 h-4 text-[#C59E3F]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                                </svg>
                            </div>
                            <h2 class="text-2xl md:text-3xl font-extrabold text-white tracking-tight">Visítanos</h2>
                        </div>
                        <p class="text-white/80 text-base leading-relaxed">
                            Calle 41 # 23-36<br />
                            Cañaveral Plaza<br />
                            Floridablanca, Colombia
                        </p>
                        <p class="text-white/60 text-sm mt-4 leading-relaxed">
                            Las puertas de esta casa están abiertas<br />para ti. ¡Ven y haz parte de esta familia!
                        </p>
                    </div>

                    <!-- Contáctanos -->
                    <div>
                        <div class="flex items-center gap-3 mb-4">
                            <div class="w-9 h-9 rounded-full bg-[#F5ECCB] border border-[#E8DAAA] flex items-center justify-center flex-shrink-0">
                                <svg class="w-4 h-4 text-[#C59E3F]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                                </svg>
                            </div>
                            <h3 class="text-2xl md:text-3xl font-extrabold text-white tracking-tight">Contáctanos</h3>
                        </div>
                        <div class="space-y-3">
                            <!-- WhatsApp -->
                            <a href="https://wa.me/573229402939" target="_blank" rel="noopener noreferrer"
                                class="flex items-center gap-3 text-white/70 hover:text-white transition-colors group">
                                <svg class="w-5 h-5 text-white/50 group-hover:text-green-400 transition-colors" fill="currentColor" viewBox="0 0 24 24">
                                    <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 00-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
                                </svg>
                                <svg class="w-5 h-5 text-white/50 group-hover:text-sky-400 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
                                </svg>
                                +57 3229402939
                            </a>
                            <!-- Email -->
                            <a href="mailto:mca.asistenciageneral@gmail.com"
                                class="flex items-center gap-3 text-white/70 hover:text-white transition-colors group">
                                <svg class="w-5 h-5 text-white/50 group-hover:text-amber-400 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                                </svg>
                                mca.asistenciageneral@gmail.com
                            </a>
                            <!-- Instagram + Facebook -->
                            <a href="https://instagram.com/iglesiamcaoficial" target="_blank" rel="noopener noreferrer"
                                class="flex items-center gap-3 text-white/70 hover:text-white transition-colors group">
                                <svg class="w-5 h-5 text-white/50 group-hover:text-pink-400 transition-colors" fill="currentColor" viewBox="0 0 24 24">
                                    <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/>
                                </svg>
                                <svg class="w-5 h-5 text-white/50 group-hover:text-blue-400 transition-colors" fill="currentColor" viewBox="0 0 24 24">
                                    <path d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z"/>
                                </svg>
                                @iglesiamcaoficial
                            </a>
                        </div>
                    </div>
                </div>

                <!-- YouTube Short Embed -->
                <div class="relative w-full max-w-[300px] sm:max-w-[340px] mx-auto aspect-[9/16] rounded-3xl overflow-hidden shadow-2xl border-4 border-white/10 transform transition-transform hover:scale-[1.02] duration-500">
                    <div class="absolute inset-0 bg-slate-900 animate-pulse flex items-center justify-center text-white/50 text-sm -z-10">
                        Cargando video...
                    </div>
                    <iframe
                        class="w-full h-full"
                        src="https://www.youtube.com/embed/vEcfPeTuEOE?autoplay=1&mute=1&loop=1&playlist=vEcfPeTuEOE"
                        title="YouTube video player"
                        frameborder="0"
                        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                        allowfullscreen
                    ></iframe>
                </div>

            </div>
        </div>
    </div>
</section>
